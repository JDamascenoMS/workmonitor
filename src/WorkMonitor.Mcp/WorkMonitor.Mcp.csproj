<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>workmonitor-mcp</AssemblyName>
    <RootNamespace>WorkMonitor.Mcp</RootNamespace>
    <UserSecretsId>2243d00b-0139-435a-8d18-5fbfb023e1a5</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WorkMonitor.Agent\WorkMonitor.Agent.csproj" />
    <ProjectReference Include="..\WorkMonitor.Core\WorkMonitor.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\WorkMonitor.Cli\appsettings.json" Link="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
